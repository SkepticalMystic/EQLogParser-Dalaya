<syncfusion:ChromelessWindow x:Class="EQLogParser.SpellPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        TitleBarHeight="{DynamicResource EQTableHeaderRowHeight}"
        TitleFontSize="{DynamicResource EQContentSize}"
        TitleBarForeground="{DynamicResource PrimaryDarken}"
        Icon="pack://application:,,,/src/ui/main/EQLogParser.ico"
        TitleTextAlignment="Left"
        WindowStyle="ToolWindow"
        Loaded="WindowLoaded"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Width="900"
        Height="580"
        MinWidth="620"
        MinHeight="400"
        Title="Insert Spell">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filter row 0: search / class / category / type / reset -->
    <Grid Grid.Row="0" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <TextBox x:Name="searchBox" Grid.Column="1" Padding="4" Margin="0,0,12,0"
               FontSize="{DynamicResource EQContentSize}"
               BorderBrush="{DynamicResource PrimaryDarken}" BorderThickness="1"
               Background="{DynamicResource ContentBackground}"
               Foreground="{DynamicResource ContentForeground}"
               TextChanged="FilterChanged" />

      <TextBlock Grid.Column="2" Text="Class:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <ComboBox x:Name="classFilter" Grid.Column="3" MinWidth="120" Margin="0,0,12,0"
                SelectionChanged="FilterChanged" />

      <TextBlock Grid.Column="4" Text="Category:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <ComboBox x:Name="categoryFilter" Grid.Column="5" MinWidth="150" Margin="0,0,12,0"
                SelectionChanged="FilterChanged" />

      <TextBlock Grid.Column="6" Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <ComboBox x:Name="typeFilter" Grid.Column="7" Width="130" Margin="0,0,12,0"
                SelectionChanged="FilterChanged" />

      <Button Grid.Column="8" Content="Reset" Click="ResetClick"
              Height="{DynamicResource EQButtonHeight}" Padding="12,0,12,0"
              Foreground="{DynamicResource PrimaryDarken}" />
    </Grid>

    <!-- Filter row 1 (P5): level / has-effect / in-slot -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="90" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="Lvl:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <Grid Grid.Column="1" Margin="0,0,4,0">
        <TextBox x:Name="levelMin" Padding="4"
                 FontSize="{DynamicResource EQContentSize}"
                 BorderBrush="{DynamicResource PrimaryDarken}" BorderThickness="1"
                 Background="{DynamicResource ContentBackground}"
                 Foreground="{DynamicResource ContentForeground}"
                 TextChanged="FilterChanged" />
        <TextBlock IsHitTestVisible="False" Text="1" Padding="5,0,0,0"
                   Foreground="{DynamicResource ContentForeground}" Opacity="0.4"
                   FontSize="{DynamicResource EQContentSize}"
                   VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=levelMin}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
      <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" Margin="0,0,4,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <Grid Grid.Column="3" Margin="0,0,4,0">
        <TextBox x:Name="levelMax" Padding="4"
                 FontSize="{DynamicResource EQContentSize}"
                 BorderBrush="{DynamicResource PrimaryDarken}" BorderThickness="1"
                 Background="{DynamicResource ContentBackground}"
                 Foreground="{DynamicResource ContentForeground}"
                 TextChanged="FilterChanged" />
        <TextBlock IsHitTestVisible="False" Text="65" Padding="5,0,0,0"
                   Foreground="{DynamicResource ContentForeground}" Opacity="0.4"
                   FontSize="{DynamicResource EQContentSize}"
                   VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=levelMax}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <TextBlock Grid.Column="4" Text="Has Effect:" VerticalAlignment="Center" Margin="12,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <ComboBox x:Name="hasSpaFilter" Grid.Column="5" Margin="0,0,12,0"
                SelectionChanged="FilterChanged" />

      <TextBlock Grid.Column="6" Text="In Slot:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <ComboBox x:Name="inSlotFilter" Grid.Column="7"
                SelectionChanged="FilterChanged" />
    </Grid>

    <!-- Mode toggle (P4): shown only when dialog is opened from the Pattern field -->
    <StackPanel x:Name="modeToggleRow" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                Visibility="Collapsed">
      <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <RadioButton x:Name="insertModeRadio" Content="Insert message" IsChecked="True"
                   GroupName="PickerMode" VerticalAlignment="Center" Margin="0,0,20,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}"
                   Checked="ModeChanged" />
      <RadioButton x:Name="bundleModeRadio" Content="Generate timer bundle"
                   GroupName="PickerMode" VerticalAlignment="Center"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}"
                   Checked="ModeChanged" />
    </StackPanel>

    <!-- Caster + overlay row (P4/P5): visible only in bundle mode -->
    <StackPanel x:Name="casterRow" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8"
                Visibility="Collapsed">
      <TextBlock Text="Caster:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <TextBox x:Name="casterBox" MinWidth="180" Padding="4"
               FontSize="{DynamicResource EQContentSize}"
               BorderBrush="{DynamicResource PrimaryDarken}" BorderThickness="1"
               Background="{DynamicResource ContentBackground}"
               Foreground="{DynamicResource ContentForeground}" />
      <TextBlock Text="(leave blank to match any caster)" VerticalAlignment="Center"
                 Margin="8,0,20,0" Opacity="0.6"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <TextBlock Text="Overlay:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <ComboBox x:Name="overlayPicker" MinWidth="160"
                FontSize="{DynamicResource EQContentSize}" />
    </StackPanel>

    <syncfusion:SfDataGrid x:Name="dataGrid" Grid.Row="4"
                           AllowDraggingColumns="False"
                           AllowResizingColumns="True"
                           AllowSorting="True"
                           AutoGenerateColumns="False"
                           CurrentCellBorderThickness="0"
                           GridLinesVisibility="Both"
                           HeaderRowHeight="{DynamicResource EQTableHeaderRowHeight}"
                           IsReadOnly="True"
                           RowHeight="{DynamicResource EQTableRowHeight}"
                           ScrollViewer.CanContentScroll="False"
                           SelectionMode="Single"
                           SelectionChanged="SpellSelectionChanged"
                           CellDoubleTapped="SpellCellDoubleTapped">
      <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTextColumn HeaderText="Spell" MappingName="Name" ColumnSizer="Star" />
        <syncfusion:GridTextColumn HeaderText="Lands on You" MappingName="LandsOnYou" ColumnSizer="Star" />
        <syncfusion:GridTextColumn HeaderText="Lands on Other" MappingName="LandsOnOther" ColumnSizer="Star" />
        <syncfusion:GridTextColumn HeaderText="Wear Off" MappingName="WearOff" ColumnSizer="Star" />
      </syncfusion:SfDataGrid.Columns>
    </syncfusion:SfDataGrid>

    <!-- Insert / Generate bar -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <TextBlock x:Name="hintText" VerticalAlignment="Center" Margin="0,0,12,0"
                 Opacity="0.7"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <TextBlock x:Name="insertModeLabel" Text="Insert message:" VerticalAlignment="Center" Margin="0,0,6,0"
                 FontSize="{DynamicResource EQContentSize}"
                 Foreground="{DynamicResource ContentForeground}" />
      <ComboBox x:Name="messageField" MinWidth="140" Margin="0,0,12,0" />
      <Button Content="Insert" x:Name="insertButton" IsDefault="True"
              Height="{DynamicResource EQButtonHeight}" MinWidth="80" Padding="15,0,15,0"
              Margin="0,0,10,0" Foreground="{DynamicResource PrimaryDarken}" Click="InsertClick" />
      <Button Content="Cancel" x:Name="cancelButton"
              Height="{DynamicResource EQButtonHeight}" MinWidth="80" Padding="15,0,15,0"
              Foreground="{DynamicResource PrimaryDarken}" Click="CancelClick" />
    </StackPanel>
  </Grid>
</syncfusion:ChromelessWindow>
