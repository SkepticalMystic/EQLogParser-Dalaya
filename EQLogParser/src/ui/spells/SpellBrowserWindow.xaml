<syncfusion:ChromelessWindow x:Class="EQLogParser.SpellBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        ShowInTaskbar="True"
        TitleBarHeight="{DynamicResource EQTableHeaderRowHeight}"
        TitleFontSize="{DynamicResource EQContentSize}"
        TitleBarForeground="{DynamicResource PrimaryDarken}"
        Icon="pack://application:,,,/src/ui/main/EQLogParser.ico"
        TitleTextAlignment="Left"
        WindowStyle="ToolWindow"
        Loaded="WindowLoaded"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Width="1100"
        Height="660"
        MinWidth="700"
        MinHeight="440"
        Title="Spell Browser">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filter bar: two rows -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Row 0: name / class / category / type -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}" />
        <TextBox x:Name="searchBox" Grid.Column="1" Padding="4" Margin="0,0,12,0"
                 FontSize="{DynamicResource EQContentSize}"
                 BorderBrush="{DynamicResource PrimaryDarken}" BorderThickness="1"
                 Background="{DynamicResource ContentBackground}"
                 Foreground="{DynamicResource ContentForeground}"
                 TextChanged="FilterChanged" />

        <TextBlock Grid.Column="2" Text="Class:" VerticalAlignment="Center" Margin="0,0,6,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}" />
        <ComboBox x:Name="classFilter" Grid.Column="3" Width="130" Margin="0,0,12,0"
                  SelectionChanged="FilterChanged" />

        <TextBlock Grid.Column="4" Text="Category:" VerticalAlignment="Center" Margin="0,0,6,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}" />
        <ComboBox x:Name="categoryFilter" Grid.Column="5" Width="160" Margin="0,0,12,0"
                  SelectionChanged="FilterChanged" />

        <TextBlock Grid.Column="6" Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}" />
        <ComboBox x:Name="typeFilter" Grid.Column="7" Width="130"
                  SelectionChanged="FilterChanged" />
      </Grid>

      <!-- Row 1: level / has-effect / in-slot / reset -->
      <Grid Grid.Row="1" Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="50" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="50" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Lvl:" VerticalAlignment="Center" Margin="0,0,6,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}" />
        <TextBox x:Name="levelMin" Grid.Column="1" Padding="4" Margin="0,0,4,0"
                 FontSize="{DynamicResource EQContentSize}"
                 BorderBrush="{DynamicResource PrimaryDarken}" BorderThickness="1"
                 Background="{DynamicResource ContentBackground}"
                 Foreground="{DynamicResource ContentForeground}"
                 TextChanged="FilterChanged" />
        <TextBlock Grid.Column="2" Text="–" VerticalAlignment="Center" Margin="0,0,4,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}" />
        <TextBox x:Name="levelMax" Grid.Column="3" Padding="4" Margin="0,0,16,0"
                 FontSize="{DynamicResource EQContentSize}"
                 BorderBrush="{DynamicResource PrimaryDarken}" BorderThickness="1"
                 Background="{DynamicResource ContentBackground}"
                 Foreground="{DynamicResource ContentForeground}"
                 TextChanged="FilterChanged" />

        <TextBlock Grid.Column="4" Text="Has Effect:" VerticalAlignment="Center" Margin="0,0,6,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}" />
        <ComboBox x:Name="hasSpaFilter" Grid.Column="5" Margin="0,0,12,0"
                  SelectionChanged="FilterChanged" />

        <TextBlock Grid.Column="6" Text="In Slot:" VerticalAlignment="Center" Margin="0,0,6,0"
                   FontSize="{DynamicResource EQContentSize}"
                   Foreground="{DynamicResource ContentForeground}" />
        <ComboBox x:Name="inSlotFilter" Grid.Column="7" Margin="0,0,12,0"
                  SelectionChanged="FilterChanged" />

        <Button Grid.Column="8" Content="Reset" Click="ResetClick"
                Height="{DynamicResource EQButtonHeight}" Padding="12,0,12,0"
                Foreground="{DynamicResource PrimaryDarken}" />
      </Grid>
    </Grid>

    <syncfusion:SfDataGrid x:Name="dataGrid" Grid.Row="1"
                           AllowDraggingColumns="False"
                           AllowResizingColumns="True"
                           AllowSorting="True"
                           AutoGenerateColumns="False"
                           CurrentCellBorderThickness="0"
                           GridLinesVisibility="Both"
                           HeaderRowHeight="{DynamicResource EQTableHeaderRowHeight}"
                           IsReadOnly="True"
                           RowHeight="{DynamicResource EQTableRowHeight}"
                           ScrollViewer.CanContentScroll="False"
                           SelectionMode="Single"
                           CellDoubleTapped="OnCellDoubleTapped">
      <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTextColumn HeaderText="Spell"    MappingName="Name"     ColumnSizer="Star" />
        <syncfusion:GridTextColumn HeaderText="Lvl"      MappingName="Level"    Width="45" />
        <syncfusion:GridTextColumn HeaderText="Classes"  MappingName="Classes"  Width="180" />
        <syncfusion:GridTextColumn HeaderText="Mana"     MappingName="Mana"     Width="60" />
        <syncfusion:GridTextColumn HeaderText="Rng"      MappingName="Range"    Width="55" />
        <syncfusion:GridTextColumn HeaderText="Skill"    MappingName="Skill"    Width="110" />
        <syncfusion:GridTextColumn HeaderText="Target"   MappingName="Target"   Width="110" />
        <syncfusion:GridTextColumn HeaderText="Resist"   MappingName="Resist"   Width="80" />
        <syncfusion:GridTextColumn HeaderText="Category" MappingName="Category" Width="150" />
      </syncfusion:SfDataGrid.Columns>
    </syncfusion:SfDataGrid>

    <TextBlock x:Name="countLabel" Grid.Row="2" Margin="0,6,0,0"
               FontSize="{DynamicResource EQContentSize}"
               Foreground="{DynamicResource ContentForeground}" Opacity="0.7" />
  </Grid>
</syncfusion:ChromelessWindow>
