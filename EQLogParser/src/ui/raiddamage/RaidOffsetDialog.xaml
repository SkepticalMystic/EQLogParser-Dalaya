<syncfusion:ChromelessWindow x:Class="EQLogParser.RaidOffsetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TitleBarHeight="{DynamicResource EQTableHeaderRowHeight}"
        TitleFontSize="{DynamicResource EQContentSize}"
        TitleBarForeground="{DynamicResource PrimaryDarken}"
        Icon="pack://application:,,,/src/ui/main/EQLogParser.ico"
        TitleTextAlignment="Left"
        WindowStyle="ToolWindow"
        Loaded="WindowLoaded"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        Title="Set Time Offset">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="promptText"
               Grid.Row="0"
               Margin="20,16,20,4"
               FontSize="{DynamicResource EQContentSize}"
               Foreground="{DynamicResource ContentForeground}"
               TextWrapping="Wrap" />

    <TextBlock Grid.Row="1"
               Margin="20,0,20,8"
               FontSize="{DynamicResource EQContentSize}"
               Opacity="0.7"
               Foreground="{DynamicResource ContentForeground}"
               TextWrapping="Wrap"
               Text="Enter hours (decimals allowed). Examples: 1, -1, 0.5, -2.25" />

    <TextBox x:Name="offsetTextBox"
             Grid.Row="2"
             Margin="20,0,20,4"
             Padding="4"
             FontSize="{DynamicResource EQContentSize}"
             BorderBrush="{DynamicResource PrimaryDarken}"
             BorderThickness="1"
             Background="{DynamicResource ContentBackground}"
             Foreground="{DynamicResource ContentForeground}"
             TextChanged="OffsetTextChanged"
             KeyDown="OffsetKeyDown" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,20,16">
      <TextBlock x:Name="errorText"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0"
                 Visibility="Collapsed"
                 Foreground="{DynamicResource EQWarnForegroundBrush}"
                 FontSize="{DynamicResource EQContentSize}" />
      <Button Content="OK"
              x:Name="okButton"
              IsDefault="True"
              Height="{DynamicResource EQButtonHeight}"
              MinWidth="80"
              Padding="15,0,15,0"
              Margin="0,0,10,0"
              Foreground="{DynamicResource PrimaryDarken}"
              Click="OkClick" />
      <Button Content="Cancel"
              x:Name="cancelButton"
              Height="{DynamicResource EQButtonHeight}"
              MinWidth="80"
              Padding="15,0,15,0"
              Foreground="{DynamicResource PrimaryDarken}"
              Click="CancelClick" />
    </StackPanel>
  </Grid>
</syncfusion:ChromelessWindow>
