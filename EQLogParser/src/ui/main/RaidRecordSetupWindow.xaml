<syncfusion:ChromelessWindow x:Class="EQLogParser.RaidRecordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        TitleBarHeight="{DynamicResource EQTableHeaderRowHeight}"
        TitleFontSize="{DynamicResource EQContentSize}"
        TitleBarForeground="{DynamicResource PrimaryDarken}"
        Icon="EQLogParser.ico"
        TitleTextAlignment="Left"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        Title="Raid Recording Settings">
  <Grid Margin="20,15,20,15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Choose how to deliver the recorded combat log:" FontSize="{DynamicResource EQTitleSize}"
               Foreground="{DynamicResource PrimaryDarken}" Margin="0,0,0,12"/>

    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,8">
      <RadioButton x:Name="saveToFileRadio" Content="Save to File" FontSize="{DynamicResource EQTitleSize}"
                   Foreground="{DynamicResource PrimaryDarken}" Margin="0,0,0,6"
                   Checked="DeliveryRadioChecked"/>
      <RadioButton x:Name="sendToDiscordRadio" Content="Send to Discord via Webhook" FontSize="{DynamicResource EQTitleSize}"
                   Foreground="{DynamicResource PrimaryDarken}"
                   Checked="DeliveryRadioChecked"/>
    </StackPanel>

    <Grid Grid.Row="2" Margin="18,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="webhookUrlBox" Grid.Column="0" FontSize="{DynamicResource EQTitleSize}"
               Height="{DynamicResource EQButtonHeight}" VerticalContentAlignment="Center"
               Padding="4,0" Margin="0,0,6,0"
/>
      <Button x:Name="testButton" Grid.Column="1" Content="Test" FontSize="{DynamicResource EQTitleSize}"
              Foreground="{DynamicResource PrimaryDarken}" Height="{DynamicResource EQButtonHeight}"
              MinWidth="60" Padding="10,0"
              Click="TestButtonClick"/>
    </Grid>

    <TextBlock x:Name="testStatusText" Grid.Row="3" FontSize="{DynamicResource EQTitleSize}"
               Foreground="{DynamicResource EQGoodForegroundBrush}" Margin="18,4,0,0"
               Visibility="Collapsed"/>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="okButton" Content="OK" FontSize="{DynamicResource EQTitleSize}"
              Foreground="{DynamicResource PrimaryDarken}" Height="{DynamicResource EQButtonHeight}"
              MinWidth="80" Padding="15,0" Margin="0,0,6,0"
              Click="OkButtonClick"/>
      <Button Content="Cancel" FontSize="{DynamicResource EQTitleSize}"
              Foreground="{DynamicResource PrimaryDarken}" Height="{DynamicResource EQButtonHeight}"
              MinWidth="80" Padding="15,0"
              Click="CancelButtonClick"/>
    </StackPanel>
  </Grid>
</syncfusion:ChromelessWindow>
