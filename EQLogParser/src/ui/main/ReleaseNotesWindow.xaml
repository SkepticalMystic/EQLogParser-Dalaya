<syncfusion:ChromelessWindow x:Class="EQLogParser.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Title="Release Notes — EQLogParser-Dalaya"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        TitleBarHeight="{DynamicResource EQTableHeaderRowHeight}"
        TitleFontSize="{DynamicResource EQContentSize}"
        TitleBarForeground="{DynamicResource PrimaryDarken}"
        Icon="EQLogParser.ico"
        TitleTextAlignment="Left"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Width="720"
        Height="580"
        MinWidth="500"
        MinHeight="400">
  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <RichTextBox x:Name="rtfBox" Grid.Row="0"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource ContentBackgroundAlt3}"
                 Background="{DynamicResource ContentBackground}"
                 Foreground="{DynamicResource PrimaryDarken}"
                 Padding="8"/>
    <Button x:Name="okButton" Grid.Row="1"
            Content="OK" HorizontalAlignment="Right"
            Height="{DynamicResource EQButtonHeight}" MinWidth="80"
            Padding="15,0,15,0"
            Foreground="{DynamicResource PrimaryDarken}"
            Margin="0,12,0,0"
            Click="OkClick" IsDefault="True" IsCancel="True"/>
  </Grid>
</syncfusion:ChromelessWindow>
